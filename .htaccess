# =====================================================================
# otaboyev-sardorbek.uz – Birlashtirilgan .htaccess
# Sana: 2026-10-22
# =====================================================================

# ---------- Asosiy sozlamalar ----------
Options -Indexes
DirectoryIndex index.html
AcceptPathInfo On
ErrorDocument 404 /404.html

# ---------- Rewrite Engine ----------
RewriteEngine On

# Force HTTPS in production, but keep local development hosts on HTTP.
# The canonical host is hard-coded so an arbitrary Host header cannot turn
# this into an open redirect. Respect a trusted proxy's forwarded proto.
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on [NC]
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://otaboyev-sardorbek.uz%{REQUEST_URI} [L,R=301]

# Redirect www and alternate hosts to the canonical HTTPS host.
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\]|otaboyev-sardorbek\.uz)(:[0-9]+)?$ [NC]
RewriteRule ^ https://otaboyev-sardorbek.uz%{REQUEST_URI} [L,R=301]

# Serve the locale homepage as the root default
RewriteRule ^$ /index.html [L]

# Canonical trailing slashes must run before the internal locale rewrite,
# otherwise /uz is served directly with 200 instead of redirecting to /uz/.
RewriteRule ^(uz|en|ru)$ /$1/ [R=301,L]
RewriteRule ^(uz|en|ru)/projects$ /$1/projects/ [R=301,L]

# Redirect language root routes to correct locale page
RewriteRule ^uz/?$ /uz/index.html [L]
RewriteRule ^ru/?$ /ru/index.html [L]
RewriteRule ^en/?$ /en/index.html [L]

# Project detail and listing folders already contain index.html, so Apache's
# DirectoryIndex serves them directly. Do not add per-slug rewrite rules here:
# in .htaccess context they re-run and can loop on /<locale>/projects/<slug>/.
# Projects created in the admin panel do not have a generated static page yet;
# route only those unknown slugs to the client-rendered fallback route.
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteCond %{REQUEST_URI} ^/(uz|en|ru)/projects/([a-z0-9-]+)/?$
RewriteRule ^(uz|en|ru)/projects/([a-z0-9-]+)/?$ /$1/projects/view/?slug=$2 [L,QSA]

# ---------- Statik fayllar keshi ----------
<FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
</FilesMatch>
<FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# ---------- Admin noindex ----------
<If "%{REQUEST_URI} =~ m#^/(admin/|api\.php/admin)#">
    Header set X-Robots-Tag "noindex, nofollow"
</If>

# ---------- HTML fayllar keshi ----------
<FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

# =====================================================================
# XAVFSIZLIK SARLAVHALARI
# =====================================================================
Header always unset X-Powered-By
Header always unset Server
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set X-XSS-Protection "0"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.github.com; frame-src https://oauth.telegram.org; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests"
Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
Header always set Cross-Origin-Resource-Policy "same-origin"
Header always set X-Permitted-Cross-Domain-Policies "none"
Header always set X-Download-Options "noopen"

# =====================================================================
# HSTS
# =====================================================================
# Do not add includeSubDomains/preload on shared hosting: other subdomains
# may still be HTTP-only and would become unreachable. Enable them only after
# every subdomain is HTTPS-ready.
# Only send HSTS over HTTPS. Browsers ignore it on plain HTTP, and hiding that
# misconfiguration makes local/preview checks misleading.
<If "%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} =~ m#https#i">
    Header always set Strict-Transport-Security "max-age=31536000"
</If>

# =====================================================================
# CORS SAFETY NET
# =====================================================================
# api.php only emits wildcard CORS for public read-only JSON endpoints.
# Mutation endpoints (form, token, bot, admin) must never carry CORS headers,
# even if a future PHP change adds one by mistake.
<If "%{REQUEST_URI} =~ m#^/api\.php/(admin|bot|form_container|websites)#">
    # Header "unset" removes headers set by PHP; "always unset" covers error
    # responses. Keep both so a future PHP CORS change cannot leak.
    Header unset Access-Control-Allow-Origin
    Header always unset Access-Control-Allow-Origin
    Header unset Access-Control-Allow-Methods
    Header always unset Access-Control-Allow-Methods
    Header unset Access-Control-Allow-Headers
    Header always unset Access-Control-Allow-Headers
    Header unset Access-Control-Allow-Credentials
    Header always unset Access-Control-Allow-Credentials
</If>

# =====================================================================
# FAYL VA PAPKA HIMOYASI
# =====================================================================
# Configuration, secrets and source folders must never be served directly.
<FilesMatch "^(config\.local\.php|config\.local\.js|github_keys\.txt|\.env.*|\.git.*|composer\.(json|lock)|package(-lock)?\.json|next\.config\.js|CodeAnalyzer_v2\.py|.*\.(sql|log|bak|md))$">
    Require all denied
</FilesMatch>
RewriteRule ^(backend|database|app|components|content|scripts|node_modules)(/|$) - [F,L,NC]

# Do not allow access to hidden/system files anywhere in the tree. The ACME
# challenge directory must remain reachable for certificate renewal.
RedirectMatch 403 ^/(?!\.well-known(?:/|$))(?:.*/)?\.[^/]*(?:/|$)
