Options -Indexes
DirectoryIndex index.html
AcceptPathInfo On
ErrorDocument 404 /404.html

RewriteEngine On

# Force HTTPS in production
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect www to non-www
# RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
# RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Serve the locale homepage as the root default
RewriteRule ^$ /index.html [L]

# Redirect language root routes to correct locale page
RewriteRule ^uz/?$ /uz/index.html [L]
RewriteRule ^ru/?$ /ru/index.html [L]
RewriteRule ^en/?$ /en/index.html [L]

# Project detail and listing folders already contain index.html, so Apache's
# DirectoryIndex serves them directly. Do not add per-slug rewrite rules here:
# in .htaccess context they re-run and can loop on /<locale>/projects/<slug>/.
# Projects created in the admin panel do not have a generated static page yet;
# route only those unknown slugs to the client-rendered fallback route.
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteCond %{REQUEST_URI} ^/(uz|en|ru)/projects/([a-z0-9-]+)/?$
RewriteRule ^(uz|en|ru)/projects/([a-z0-9-]+)/?$ /$1/projects/view/?slug=$2 [L,QSA]

# Static asset cache control. CSS/JS filenames are not content-hashed in the
# legacy tree, so keep their cache short enough for a deploy to take effect.
<FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
</FilesMatch>
<FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Keep admin routes out of search indexes even if a crawler ignores meta tags.
<If "%{REQUEST_URI} =~ m#^/admin/#">
    Header set X-Robots-Tag "noindex, nofollow"
</If>

# HTML files: short cache to refresh after deploys
<FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

# Security headers
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
Header always set Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
Header always set Strict-Transport-Security "max-age=31536000"

# Configuration and source folders must never be served directly.
<FilesMatch "^(config\.local\.php|config\.local\.js|\.env.*|\.git.*)$">
    Require all denied
</FilesMatch>
RewriteRule ^(backend|database)/ - [F,L]

# Do not allow access to hidden/system files
RedirectMatch 403 ^/(?!\.well-known/)\..*
