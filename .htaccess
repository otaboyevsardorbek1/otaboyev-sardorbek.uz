Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Force HTTPS in production
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect www to non-www
# RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
# RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Serve the locale homepage as the root default
RewriteRule ^$ /index.html [L]

# Redirect language root routes to correct locale page
RewriteRule ^uz/?$ /uz/index.html [L]
RewriteRule ^ru/?$ /ru/index.html [L]
RewriteRule ^en/?$ /en/index.html [L]

# Preserve localized project detail routes
RewriteRule ^uz/projects/([^/]+)/?$ /uz/projects/$1/index.html [L]
RewriteRule ^ru/projects/([^/]+)/?$ /ru/projects/$1/index.html [L]
RewriteRule ^en/projects/([^/]+)/?$ /en/projects/$1/index.html [L]

# Friendly fallback for project detail nested routes if present
RewriteRule ^uz/projects/([^/]+)/(.+)$ /uz/projects/$1/$2 [L]
RewriteRule ^ru/projects/([^/]+)/(.+)$ /ru/projects/$1/$2 [L]
RewriteRule ^en/projects/([^/]+)/(.+)$ /en/projects/$1/$2 [L]

# Static asset cache control
<FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# HTML files: short cache to refresh after deploys
<FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

# Security headers
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

# Do not allow access to hidden/system files
RedirectMatch 403 ^/\..*

# If the requested file or folder doesn't exist, try to serve the root index.html for SPA-like fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
