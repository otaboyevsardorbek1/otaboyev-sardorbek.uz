# Content API database settings.
# PHP does not load this file automatically: export these variables in the
# hosting environment, or use config.local.php instead (see the example).

DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_portfolio
DB_USER=cpaneluser_portfolio
DB_PASS=change-me
# DB_SOCKET=/path/to/mysql.sock

# Admin panel / Telegram / email settings.
APP_ENV=production
SITE_URL=https://otaboyev-sardorbek.uz
# Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=66188c73179db3af5f2ed1417ecb807f676254426e49473b1c0e5aceb9bce6fd  
TELEGRAM_BOT_TOKEN=123456789:replace-with-botfather-token
TELEGRAM_BOT_USERNAME=YourAdminBot
ADMIN_TELEGRAM_ID=123456789
ADMIN_EMAIL=admin@otaboyev-sardorbek.uz
ADMIN_SESSION_TTL=43200
ADMIN_CHALLENGE_TTL=600
ADMIN_OTP_MAX_ATTEMPTS=5
ADMIN_TELEGRAM_AUTH_WINDOW=300
# Set to 1 only when HTTPS is terminated by a trusted reverse proxy.
ADMIN_TRUST_PROXY=0

# Email delivery: mail (cPanel), smtp, resend or brevo.
ADMIN_MAIL_DRIVER=mail
ADMIN_MAIL_FROM=no-reply@otaboyev-sardorbek.uz
ADMIN_MAIL_FROM_NAME=Sardorbek Otaboyev
# SMTP (only when ADMIN_MAIL_DRIVER=smtp)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
# API drivers (only when selected)
RESEND_API_KEY=
BREVO_API_KEY=
# Local testing only: write the OTP to a file instead of sending email.
# ADMIN_MAIL_DRIVER=log
# ADMIN_MAIL_LOG=/tmp/opencode/admin-mail.log
